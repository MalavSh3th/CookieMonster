{
  "name": "Cookie Monster",
  "description": "See where a site's cookies are stored, what they do with your data, how risky each one is, and delete them in one click.",
  "version": "2.0",
  "manifest_version": 3,
  "permissions": ["cookies", "tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
